class DetectedDockPosePublisher : public rclcpp::Node
{
public:
  DetectedDockPosePublisher()
  : Node("detected_dock_pose_publisher"), tf_buffer_(this->get_clock()), tf_listener_(tf_buffer_)
  {

    // Declare parameters with default values and documentation
    this->declare_parameter("parent_frame", "depth_camera_optical_frame"); //Reference frame default "depth_camera_optical_frame"
    this->declare_parameter("child_frame", "home_ID"); // Default to the tag_ID name (NOT THE DOCK NAME!), can be overridden for other tags

    publisher_ = this->create_publisher<geometry_msgs::msg::PoseStamped>("/detected_dock_pose", 10);


    // Get the values of our parameters
    parent_frame_ = this->get_parameter("parent_frame").as_string();
    child_frame_ = this->get_parameter("child_frame").as_string();
    
    // Timer to periodically check/publish the dock pose based on the latest detection
    timer_ = this->create_wall_timer(
      100ms, std::bind(&DetectedDockPosePublisher::timer_callback, this));
  }

private:
  void timer_callback()
  {
    try {
      // 1. Get the static transform from camera to base_link (cached statically)
      geometry_msgs::msg::TransformStamped cam_to_base;
      cam_to_base = tf_buffer_.lookupTransform(
        "base_link", "parent_frame", tf2::TimePointZero);

      // 2. Get the current transform from base_link to odom
      geometry_msgs::msg::TransformStamped base_to_odom;
      base_to_odom = tf_buffer_.lookupTransform(
        "odom", "base_link", tf2::TimePointZero);

      // (Assuming you have an external subscriber/mechanism to capture the tag's pose)
      // geometry_msgs::msg::PoseStamped tag_pose; 
      // ... fill tag_pose with latest AprilTag detection ...

      // 3. Transform to odom frame using the cached static & odometry transforms
      geometry_msgs::msg::PoseStamped transformed_pose;
      // Combine and publish to /detected_dock_pose
      // ...
    } catch (const tf2::TransformException & ex) {
      // Uncomment for debugging
      // RCLCPP_WARN(this->get_logger(), "Could not transform: %s", ex.what());
    }
  }

  rclcpp::TimerBase::SharedTimer timer_;
  rclcpp::Publisher<geometry_msgs::msg::PoseStamped>::SharedPublisher publisher_;
  tf2_ros::Buffer tf_buffer_;
  tf2_ros::TransformListener tf_listener_;
};

int main(int argc, char * argv[])
{
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<DetectedDockPosePublisher>());
  rclcpp::shutdown();
  return 0;
}
